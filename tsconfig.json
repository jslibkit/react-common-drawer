{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["DOM", "ES2020"]
  },
  "include": [
    "./*.ts",
    "./*.tsx",
    "./scripts/**/*.mjs",
    "./vitest.config.ts"
  ]
}
