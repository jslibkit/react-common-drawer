{
  "name": "@jslibkit/react-common-drawer",
  "version": "2.0.0",
  "description": "Imperative, accessible drawer components for React 18 and React 19 with pure CSS and Tailwind styling modes.",
  "license": "MIT",
  "sideEffects": [
    "./dist/drawer.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "INSTALLATION.md",
    "UPGRADING.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jslibkit/react-common-drawer.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "react18": ["./dist/Drawer.d.ts"],
      "react19": ["./dist/Drawer.react19.d.ts"],
      "headless": ["./dist/DrawerHeadless.d.ts"]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./react18": {
      "import": {
        "types": "./dist/Drawer.d.mts",
        "default": "./dist/Drawer.mjs"
      },
      "require": {
        "types": "./dist/Drawer.d.ts",
        "default": "./dist/Drawer.js"
      }
    },
    "./react19": {
      "import": {
        "types": "./dist/Drawer.react19.d.mts",
        "default": "./dist/Drawer.react19.mjs"
      },
      "require": {
        "types": "./dist/Drawer.react19.d.ts",
        "default": "./dist/Drawer.react19.js"
      }
    },
    "./headless": {
      "import": {
        "types": "./dist/DrawerHeadless.d.mts",
        "default": "./dist/DrawerHeadless.mjs"
      },
      "require": {
        "types": "./dist/DrawerHeadless.d.ts",
        "default": "./dist/DrawerHeadless.js"
      }
    },
    "./drawer.css": "./dist/drawer.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && node ./scripts/postbuild.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
